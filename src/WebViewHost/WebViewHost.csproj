<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NavisworksDockPanel.WebViewHost</AssemblyName>
    <RootNamespace>NavisworksDockPanel.WebViewHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- This assembly is NEVER scanned directly by Navisworks - it has no [Plugin] classes
         and is loaded on demand, by reflection, from NavisworksDockPanel.AddIn.dll only
         after that entry assembly has already registered successfully. Isolating the
         WebView2 dependency here is what lets the entry assembly load reliably. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebUiAssets is populated by build/copy-webui-dist.ps1 from src/WebUI/dist -->
    <Content Include="WebUiAssets\**\*" Condition="Exists('WebUiAssets')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
